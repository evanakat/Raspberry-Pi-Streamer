[Unit]
Description=Pi Streamer: TV remote (HDMI-CEC) to keyboard keys
After=pi-streamer-cec.service
Wants=pi-streamer-cec.service

[Service]
ExecStartPre=-/sbin/modprobe uinput
ExecStart=/usr/bin/python3 /opt/pi-streamer/system/remote.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
